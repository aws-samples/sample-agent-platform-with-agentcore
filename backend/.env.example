# Copy to .env and fill in the RuntimeStack / PlatformStack outputs.
PLATFORM_AWS_REGION=us-east-1
PLATFORM_DYNAMO_TABLE=agent-platform
PLATFORM_INTERACTIVE_RUNTIME_ARN=arn:aws:bedrock-agentcore:REGION:ACCOUNT:runtime/RUNTIME_ID
PLATFORM_SDK_RUNTIME_ARN=arn:aws:bedrock-agentcore:REGION:ACCOUNT:runtime/RUNTIME_ID
PLATFORM_WORKSPACE_BUCKET=agent-platform-workspaces-ACCOUNT-REGION
# Optional static bearer token; empty = open (local dev only)
PLATFORM_API_TOKEN=
# Local development without any IdP or token: must be asked for explicitly.
PLATFORM_ALLOW_OPEN_AUTH=1
PLATFORM_CORS_ORIGINS=http://localhost:5173
